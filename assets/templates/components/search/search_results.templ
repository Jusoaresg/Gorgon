package search

import "gorgon/external/tvmaze/schema"
import "gorgon/assets/templates/components/add_show"

templ SearchResults(shows []schema.TvMazeResponse) {
	<div id="search-results" class="results-container">
		if len(shows) > 0 {
			for _, show := range shows {
				@add_show.ShowCard(show.Show)
			}
		} else {
			<div class="empty-state">
				<p>Search for a show to add it to your collection</p>
			</div>
		}
	</div>
}
