package pages

import "gorgon/assets/templates/layouts"
import "gorgon/internal/db/model"
import "strconv"
import "time"
import "strings"

templ Show(title string, show model.Show) {
	<head>
		<link href="/css/pages/show.css" rel="stylesheet"/>
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"/>
	</head>
	@layouts.Base(title) {
		<div class="show-container">
			<div class="show-header">
				<h1>{ show.Name }</h1>
				<div class="show-meta">
					<span class="show-status">{ show.Status }</span>
					if show.Premiered != "" {
						<span class="show-date">{ show.Premiered } - { show.Ended }</span>
					}
					if show.Language != "" {
						<span class="show-language">{ show.Language }</span>
					}
				</div>
			</div>
			<div class="show-overview">
				<div class="show-poster">
					if show.Image.Medium != "" {
						<img src={ show.Image.Medium } alt={ show.Name + " Poster" }/>
					} else {
						<div class="placeholder-poster">
							<span>{ string([]rune(show.Name)[0]) }</span>
						</div>
					}
				</div>
				<div class="show-summary">
					@templ.Raw(show.Summary)
					<div class="show-actions">
						<button class="action-btn refresh-btn">
							<i class="fas fa-sync-alt"></i> Refresh Show Info
						</button>
						<button class="action-btn search-all-btn">
							<i class="fas fa-search"></i> Search All Missing
						</button>
					</div>
				</div>
			</div>
			<div class="seasons-navigation">
				for i := 0; i < len(show.Seasons); i++ {
					<a href={ templ.SafeURL("#season-" + strconv.FormatInt(int64(show.Seasons[i].Number), 10)) } class="season-pill">
						Season { strconv.FormatInt(int64(show.Seasons[i].Number), 10) }
					</a>
				}
			</div>
			for i := len(show.Seasons)-1; i >= 0; i-- {
				<div id={ "season-" + strconv.FormatInt(int64(show.Seasons[i].Number), 10) } class="season-block">
					<div class="season-header">
						<h2>Season { strconv.FormatInt(int64(show.Seasons[i].Number), 10) }</h2>
						<div class="season-actions">
							<button class="action-btn season-search-btn" data-season={ strconv.FormatInt(int64(show.Seasons[i].Number), 10) }>
								<i class="fas fa-search"></i> Search Season
							</button>
						</div>
					</div>
					<div class="episodes-container">
						for e := 0; e < len(show.Episodes); e++ {
							if show.Episodes[e].Season == show.Seasons[i].Number {
								@EpisodeCard(show.Episodes[e], show.Seasons[i].Number)
							}
						}
					</div>
				</div>
			}
		</div>
		<script>
			// Add event listeners for various buttons
			document.addEventListener('DOMContentLoaded', function() {
				// Episode status toggle function
				document.querySelectorAll('.episode-status-toggle').forEach(toggle => {
					toggle.addEventListener('click', function() {
						const episodeId = this.closest('.episode-card').dataset.episodeId;
						const currentStatus = this.closest('.episode-card').dataset.status;
						// Here you would call your API to update the status
						console.log(`Toggle status for episode ${episodeId} from ${currentStatus}`);
					});
				});

				// Force search buttons
				document.querySelectorAll('.force-search-btn').forEach(btn => {
					btn.addEventListener('click', function() {
						const episodeId = this.closest('.episode-card').dataset.episodeId;
						console.log(`Force search for episode ${episodeId}`);
					});
				});

				// Manual search buttons
				document.querySelectorAll('.manual-search-btn').forEach(btn => {
					btn.addEventListener('click', function() {
						const episodeId = this.closest('.episode-card').dataset.episodeId;
						console.log(`Manual search for episode ${episodeId}`);
					});
				});

				// Season search buttons
				document.querySelectorAll('.season-search-btn').forEach(btn => {
					btn.addEventListener('click', function() {
						const seasonNumber = this.dataset.season;
						console.log(`Search for all missing episodes in season ${seasonNumber}`);
					});
				});

				// Search all missing
				document.querySelector('.search-all-btn').addEventListener('click', function() {
					console.log('Search for all missing episodes in series');
				});

				// Refresh show info
				document.querySelector('.refresh-btn').addEventListener('click', function() {
					console.log('Refresh show information');
				});
			});
		</script>
	}
}

templ EpisodeCard(episode model.Episode, seasonNumber int) {
	@episodeCard(episode, seasonNumber, getEpisodeStatus(episode))
}

templ episodeCard(episode model.Episode, seasonNumber int, status string) {
	<div class="episode-card" data-episode-id={ strconv.FormatInt(int64(episode.ID), 10) } data-status={ status }>
		<div class={ "episode-number " + getStatusClass(status) }>
			<span>{ strconv.FormatInt(int64(episode.Number), 10) }</span>
			<div class="absolute-number">
				{ strconv.FormatInt(int64(getAbsoluteNumber(episode, seasonNumber)), 10) }
			</div>
		</div>
		<div class="episode-content">
			<div class="episode-header">
				<h3 class="episode-title">{ episode.Name }</h3>
				<div class="episode-actions">
					<button class="episode-btn force-search-btn" title="Force Search">
						<i class="fas fa-search"></i>
					</button>
					<button class="episode-btn manual-search-btn" title="Manual Search">
						<i class="fas fa-list"></i>
					</button>
					<button class={ "episode-btn episode-status-toggle " + getStatusClass(status) } title="Toggle Status">
						<i class={ getStatusIcon(status) }></i>
					</button>
					//@EpisodeRow(episode)
				</div>
			</div>
			<div class="episode-info">
				<div class="episode-date">
					if episode.AirStamp != "" {
						<span class={ "air-date " + getAirStatusClass(episode.AirStamp) }>
							<i class={ getAirStatusIcon(episode.AirStamp) }></i>
							{ formatDate(episode.AirStamp) }
						</span>
					}
				</div>
				if episode.Summary != "" {
					<div class="episode-summary">
						@templ.Raw(episode.Summary)
					</div>
				}
			</div>
		</div>
	</div>
}

templ EpisodeRow(episode model.Episode) {
	<tr>
		<td>{ strconv.Itoa(int(episode.Number)) }</td>
		<td>{ episode.Name }</td>
		<td>
			<select
				class="status-dropdown p-1 rounder border border-gray-300"
				hx-post={ "/api/episodes/" + strconv.Itoa(int(episode.ID)) + "/status" }
				hx-trigger="change"
				hx-swap="none"
			>
				<option
					value="missing"
					if episode.Tracking == "missing" {
						selected
					}
				>Missing</option>
				<option
					value="wanted"
					if episode.Tracking == "wanted" {
						selected
					}
				>Wanted</option>
				<option
					value="skipped"
					if episode.Tracking == "skipped" {
						selected
					}
				>Skipped</option>
				<option
					value="snatched"
					if episode.Tracking == "snatched" {
						selected
					}
				>Snatched</option>
			</select>
		</td>
	</tr>
}

// Helper function to format date
func formatDate(dateStr string) string {
	if dateStr == "" {
		return ""
	}
	// Parse the ISO8601 date format
	t, err := time.Parse(time.RFC3339, dateStr)
	if err != nil {
		return dateStr
	}
	// Format as Month Day, Year
	return t.Format("January 2, 2006")
}

// Helper functions for episode status
func getEpisodeStatus(episode model.Episode) string {
	// Statuses: "downloaded", "missing", "wanted", "skipped", "snatched"
	return string(episode.Tracking)
}

func getStatusClass(status string) string {
	switch strings.ToLower(status) {
	case "downloaded":
		return "status-downloaded"
	case "missing":
		return "status-missing"
	case "wanted":
		return "status-wanted"
	case "skipped":
		return "status-skipped"
	case "snatched":
		return "status-snatched"
	default:
		return "status-unknown"
	}
}

func getStatusIcon(status string) string {
	switch strings.ToLower(status) {
	case "downloaded":
		return "fas fa-check"
	case "missing":
		return "fas fa-times"
	case "wanted":
		return "fas fa-clock"
	case "skipped":
		return "fas fa-ban"
	case "snatched":
		return "fas fa-magnet"
	default:
		return "fas fa-question"
	}
}

func getAirStatusClass(airDate string) string {
	if airDate == "" {
		return "no-date"
	}

	// Parse the date
	t, err := time.Parse(time.RFC3339, airDate)
	if err != nil {
		return "invalid-date"
	}

	now := time.Now()
	if t.After(now) {
		return "not-aired"
	}
	return "aired"
}

func getAirStatusIcon(airDate string) string {
	if airDate == "" {
		return "fas fa-question-circle"
	}

	// Parse the date
	t, err := time.Parse(time.RFC3339, airDate)
	if err != nil {
		return "fas fa-exclamation-circle"
	}

	now := time.Now()
	if t.After(now) {
		return "fas fa-clock"
	}
	return "fas fa-calendar-check"
}

// Helper to calculate absolute episode number
func getAbsoluteNumber(episode model.Episode, seasonNumber int) int {
	// This is just a simplified placeholder calculation
	// In real app, this would be more accurate based on your data
	return (seasonNumber-1)*10 + episode.Number
}
