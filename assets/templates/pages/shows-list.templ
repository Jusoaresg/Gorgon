package pages

import "gorgon/internal/db/model"
import "gorgon/assets/templates/layouts"
import "gorgon/assets/templates/components"

templ ShowsList(title string, shows []model.Show) {
	@layouts.Base(title) {
		<div class="home-container">
			<h1>My Shows</h1>
			<div class="categories">
				@components.SearchForm("/", ".shows-grid", ".spinning", "keyup, changed delay:500ms", "Filter the show", false)
				//<div class="category active">All Shows</div>
				//<div class="category">Currently Watching</div>
				//<div class="category">Completed</div>
				//<div class="category">Plan to Watch</div>
			</div>
			if len(shows) > 0 {
				<div class="shows-grid">
					@components.ShowGridShowsList(shows)
				</div>
			} else {
				<div class="empty-state">
					<p>You haven\'t added any shows yet. <a href="/add">Add your first show</a>.</p>
				</div>
			}
		</div>
	}
}
