package pages

import "gorgon/assets/templates/components"
import "gorgon/assets/templates/layouts"
import "gorgon/external/tvmaze/schema"

templ AddShow(title string, shows []schema.TvMazeResponse) {
	@layouts.Base(title) {
		<div class="add-show-container">
			<h1>Add Show</h1>
			@components.SearchForm("/add", "#search-results", ".spinner", "", "Enter show name...", true)
			@components.SearchResults(shows)
		</div>
	}
}
